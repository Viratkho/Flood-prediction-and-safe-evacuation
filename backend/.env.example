# FloodGuard 2.1 — Backend Configuration (Completely Free & Local)

# Server Port (default 3000 to maintain compatibility with test suite and frontend)
PORT=3000

# SQLite Database Persistence File (Persistent local file path)
DATABASE_PATH=backend/data/floodguard.db

# Optional External AI API Key (Google Gemini)
# Free tier key or leave blank to automatically use the built-in deterministic tactical rule engine
GEMINI_API_KEY=

# Optional Commercial SMS Gateway Credentials (If omitted, free ntfy.sh and native carrier SMS links are used)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=
TEXTBELT_KEY=
