# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Free tier gives 15 RPM / 1M TPM / 1,500 RPD with 0 cost.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# FREE MOBILE SMS & DISASTER ALERT APIS (No Credit Card / Zero Cost)
# ------------------------------------------------------------------------------
# FloodGuard is fully integrated with zero-cost secure mobile notification tiers:
#
# 1. Textbelt Free Open Tier API (https://textbelt.com/text):
#    Keyless free tier requires zero registration or credit card (default key: "textbelt").
#    Optional: Set custom key below if you have your own Textbelt quota.
TEXTBELT_API_KEY="textbelt"

# 2. ntfy.sh Free Secure Emergency Mobile Alert Network (https://ntfy.sh):
#    100% Free, open-source, encrypted push notifications with urgent priority, sound, and action links.
#    Subscribers or mobile apps can receive alerts on Android/iOS/Web without accounts or payment.
NTFY_TOPIC="floodguard-emergency-alerts"

# 3. Direct Native Cellular Carrier SMS (RFC 5724):
#    Always active automatically! Generates direct 'sms:' protocol links so users and operators
#    can send real cellular SMS directly through their mobile carrier plan with zero external gateway fees.

# ------------------------------------------------------------------------------
# OPTIONAL PAID CELLULAR GATEWAYS (Fallback / Enterprise)
# ------------------------------------------------------------------------------
# If you have paid Twilio or Fast2SMS credentials, enter them below:
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
FAST2SMS_API_KEY=""
